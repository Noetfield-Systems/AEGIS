{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AEGIS WorkPacket",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "venture_id",
    "objective",
    "owner_role",
    "acceptance_criteria",
    "source_issue_url",
    "due_at",
    "budget_limit_cad",
    "authorized_scope"
  ],
  "properties": {
    "schema": {
      "const": "aegis-workpacket-v1"
    },
    "id": {
      "type": "string",
      "minLength": 3
    },
    "venture_id": {
      "const": "aegis"
    },
    "company_os_id": {
      "type": "string"
    },
    "objective": {
      "type": "string",
      "minLength": 8
    },
    "owner_role": {
      "enum": [
        "GM",
        "PRODUCT",
        "ENGINEER",
        "POLICY",
        "AI-EVAL",
        "GTM",
        "QA",
        "FINANCE"
      ]
    },
    "source_issue_url": {
      "type": "string",
      "format": "uri"
    },
    "priority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "authorized_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "due_at": {
      "type": "string",
      "format": "date-time"
    },
    "budget_limit_cad": {
      "type": "number",
      "minimum": 0
    },
    "evidence_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_environment": {
      "enum": [
        "local-test",
        "staging",
        "production"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}